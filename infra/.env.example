# cp infra/.env.example infra/.env 후 값을 바꾼다. .env는 커밋하지 않는다.
POSTGRES_PASSWORD=change-me
ORACLE_PASSWORD=change-me
WEB_PORT=8000

# 첫 관리자(관리자가 한 명도 없을 때만 동작)
#   이메일 로그인 관리자: 두 값 모두 설정(비밀번호 12자 이상) → 기동 시 생성
#   Google 로그인 관리자: 이메일만 설정 → 그 이메일로 처음 Google 로그인한 사용자가 관리자가 된다
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Google 로그인(선택). 비워 두면 이메일 가입·로그인만 동작한다.
#   승인된 리디렉션 URI: http://localhost:8000/login/oauth2/code/google (로컬)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
